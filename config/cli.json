{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "nord",
    "mode": "system"
  },
  "animations": true,
  "mouse": true,
  "session": {
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "image_preview": true,
    "scrollbar": true,
    "permissions": "autoaccept",
    "verbosity": "low"
  },
  "tabs": {
    "layout": "horizontal"
  },
  "terminal": {
    "copy": "manual"
  },
  "diffs": {
    "view": "auto",
    "wrap": "word"
  },
  "attention": {
    "sound": false
  }
}

# PowerShell 脚本用 CRLF，避免在 Windows 上出现奇怪问题
*.ps1 text eol=crlf
*.cmd text eol=crlf
# 其余统一 LF
*.md  text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# demo 里的 html/js/css 统一 LF，保证 clone 出来跟本机字节一致
*.html text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.svg  text eol=lf
*.txt  text eol=lf